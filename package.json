  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "--debug 0.0.0.0:9229",
    "start:prod": "NODE_OPTIONS='--require @opentelemetry/auto-instrumentations-node/register' node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest -c jest.config.js",
    "test:watch": "jest -c jest.config.js --watch",
    "test:cov": "jest -c jest.config.js --coverage",
    "test:integration": "jest -c jest.integration.config.js",
    "test:integration:cov": "jest -c jest.integration.config.js --coverage",
    "test:all": "npm run test:cov && npm run test:integration:cov"
  },
