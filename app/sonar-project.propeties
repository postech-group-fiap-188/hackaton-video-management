sonar.projectKey=postech-group-fiap-188_hackaton-video-management
sonar.organization=postech-group-fiap-188
sonar.host.url=https://sonarcloud.io

sonar.sourceEncoding=UTF-8

sonar.sources=src

sonar.tests=src
sonar.test.inclusions=src/**/*.spec.ts


sonar.javascript.lcov.reportPaths=coverage/unit/lcov.info

sonar.exclusions=\
dist/**,\
node_modules/**,\
coverage/**,\
src/**/*.spec.ts,\
src/**/*.test.ts,\
src/contexts/video/domain/**,\
src/contexts/video/application/gateways/**,\
src/contexts/video/domain/value-objects/**,\
src/interfaces/**,\
src/scripts/**
